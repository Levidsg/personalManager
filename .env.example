# Conexão do aplicativo (Supabase Pooler em modo Transação, porta 6543)
# Exemplo: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Conexão para migrações Drizzle Kit (Supabase Pooler em modo Sessão, porta 5432, ou conexão direta)
# Exemplo: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_MIGRATION_URL=""

# (Opcional - Plano B) PIN de acesso numérico para proteção extra (ex: "1234")
# Se não configurado, nenhuma barreira de PIN é exibida.
APP_ACCESS_PIN=""

    "db:clear": "tsx scripts/limpar-dados.ts",
    "db:check": "tsx scripts/check-db.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "cmdk": "^1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nuqs": "2.10.2",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
